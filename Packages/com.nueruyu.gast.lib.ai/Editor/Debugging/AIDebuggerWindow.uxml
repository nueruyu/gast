<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:d="Gast.Lib.AI.Editor.Debugging">
    <Style src="AIDebuggerWindow.uss" />

    <ui:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="250">
        <d:ActorListView class="pane" />

        <ui:VisualElement class="pane">
            <d:DomainToolbarView />

            <ui:TwoPaneSplitView fixed-pane-index="0" orientation="Vertical" fixed-pane-initial-dimension="300">
                <ui:ScrollView class="pane" mode="Vertical">
                    <d:WorldStateView />
                    <d:CurrentPlanView />
                </ui:ScrollView>

                <d:LogListView class="pane" />
            </ui:TwoPaneSplitView>
        </ui:VisualElement>
    </ui:TwoPaneSplitView>
</ui:UXML>
