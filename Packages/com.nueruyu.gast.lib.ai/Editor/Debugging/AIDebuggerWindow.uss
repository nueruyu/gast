.pane {
    min-width: 150px;
    min-height: 100px;
}

/* ActorListView */
.actor-list-view__header {
    -unity-font-style: bold;
    margin-top: 5px;
    margin-left: 5px;
}

.actor-list-view__list {
    flex-grow: 1;
    margin: 5px;
}

.actor-list-view__item {
    padding: 2px;
}

/* DomainToolbarView */
.domain-toolbar-view {
    flex-direction: row;
    padding: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 40, 40);
}

.domain-toolbar-view #unity-checkmark {
    display: none;
}

.domain-toolbar-view .unity-toggle {
    margin-right: 2px;
    border-radius: 3px 3px 0 0;
    border-width: 1px 1px 0 1px;
    border-color: rgb(40, 40, 40);
    background-color: rgb(60, 60, 60);
    color: rgb(180, 180, 180);
}

.domain-toolbar-view .unity-toggle:checked {
    background-color: rgb(75, 75, 75);
    color: white;
    border-bottom-width: 1px;
    border-bottom-color: rgb(75, 75, 75);
    margin-bottom: -1px;
}

/* WorldStateView */
.world-state-view__header {
    -unity-font-style: bold;
    margin-top: 5px;
    margin-left: 5px;
}

.world-state-view__container {
    margin: 5px;
    padding: 5px;
    background-color: rgb(51, 51, 51);
    border-radius: 3px;
}

.world-state-view__row {
    flex-direction: row;
    padding: 2px 0;
}

.world-state-view__name {
    min-width: 150px;
    color: rgb(150, 150, 150);
}

.world-state-view__value {
    flex-grow: 1;
    white-space: normal;
}

.world-state-view__value--true {
    color: rgb(100, 200, 100);
}

.world-state-view__value--false {
    color: rgb(200, 100, 100);
}

/* CurrentPlanView */
.current-plan-view__header {
    -unity-font-style: bold;
    margin-top: 10px;
    margin-left: 5px;
}

.current-plan-view__info-row {
    flex-direction: row;
    margin: 5px 5px 0 5px;
    font-size: 11px;
}

.current-plan-view__info-label {
    min-width: 60px;
    color: rgb(150, 150, 150);
}

.current-plan-view__info-value {
    color: white;
}

.current-plan-view__list {
    flex-grow: 1;
    min-height: 80px;
    margin: 5px;
}

.current-plan-view__item {
    padding: 2px;
}

.current-plan-view__item--active {
    background-color: rgb(77, 102, 153);
}

/* LogListView */
.log-list-view__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-right: 5px;
}

.log-list-view__section-label {
    -unity-font-style: bold;
    margin-top: 5px;
    margin-left: 5px;
}

.log-list-view__controls {
    flex-direction: row;
    align-items: center;
}

.log-list-view__list {
    flex-grow: 1;
    margin: 5px;
}

.log-list-view__item {
    padding: 2px;
    white-space: normal;
}
