.pane {
    min-width: 150px;
    min-height: 100px;
}

.actor-list {
    flex-grow: 1;
    margin: 5px;
}

.domain-toolbar {
    flex-direction: row;
    padding: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 40, 40);
}

.domain-toolbar #unity-checkmark {
    display: none;
}

.domain-toolbar .unity-toggle {
    margin-right: 2px;
    border-radius: 3px 3px 0 0;
    border-width: 1px 1px 0 1px;
    border-color: rgb(40, 40, 40);
    background-color: rgb(60, 60, 60);
    color: rgb(180, 180, 180);
}

.domain-toolbar .unity-toggle:checked {
    background-color: rgb(75, 75, 75);
    color: white;
    border-bottom-width: 1px;
    border-bottom-color: rgb(75, 75, 75);
    margin-bottom: -1px;
}

.section-header {
    -unity-font-style: bold;
    margin-top: 5px;
    margin-left: 5px;
}

.section-header--plan {
    margin-top: 10px;
}

.info-row {
    flex-direction: row;
    margin: 5px 5px 0 5px;
    font-size: 11px;
}

.info-label {
    min-width: 60px;
    color: rgb(150, 150, 150);
}

.info-value {
    color: white;
}

.world-state-container {
    margin: 5px;
    padding: 5px;
    background-color: rgb(51, 51, 51);
    border-radius: 3px;
}

.world-state-row {
    flex-direction: row;
    padding: 2px 0;
}

.world-state-name {
    min-width: 150px;
    color: rgb(150, 150, 150);
}

.world-state-value {
    flex-grow: 1;
    white-space: normal;
}

.world-state-value--true {
    color: rgb(100, 200, 100);
}

.world-state-value--false {
    color: rgb(200, 100, 100);
}

.plan-list {
    flex-grow: 1;
    min-height: 80px;
    margin: 5px;
}

.log-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-right: 5px;
}

.log-controls {
    flex-direction: row;
    align-items: center;
}

.log-list {
    flex-grow: 1;
    margin: 5px;
}

.list-item {
    padding: 2px;
}

.list-item--log {
    white-space: normal;
}

.list-item--active {
    background-color: rgb(77, 102, 153);
}
