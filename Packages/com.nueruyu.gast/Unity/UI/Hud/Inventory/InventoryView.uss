.inventory {
    flex-direction: row;
    align-items: flex-start;
}

.inventory__item-slot {
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 4px;
    margin-right: 4px;
    width: 64px;
    height: 64px;
    justify-content: space-between;
    align-items: stretch;
    border-width: 2px;
    border-color: #444;
}

.inventory__slot-number {
    position: absolute;
    top: 2px;
    left: 4px;
    font-size: 12px;
    color: #aaa;
    -unity-font-style: bold;
}

.inventory__item-text {
    color: white;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: lower-right;
    padding: 4px;
}
