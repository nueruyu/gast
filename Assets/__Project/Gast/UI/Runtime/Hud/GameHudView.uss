/* ==========================================================================
   Game HUD (BEM)
   ========================================================================== */

.game-hud {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    justify-content: space-between;
    justify-content: space-between;
}

/* --- Status Group (Top Left) --- */
.game-hud__status-group {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    padding: 12px;
    width: 250px;
    align-items: flex-start;
}

.game-hud__hp-container {
    background-color: rgb(40, 40, 40);
    width: 100%;
    height: 24px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 8px;
    justify-content: center;
}

.game-hud__hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(220, 50, 50);
    width: 100%;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.game-hud__hp-label {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    align-self: center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.game-hud__money-label {
    color: rgb(255, 215, 0);
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 4px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* --- Inventory Container (Bottom Left) --- */
.game-hud__inventory-container {
    flex-direction: column;
    align-items: flex-start;
    max-height: 400px;
    width: 250px;
}

.game-hud__item-slot {
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 4px;
    padding: 8px;
    margin-top: 4px;
    flex-direction: row;
    width: 100%;
    border-left-width: 4px;
    border-left-color: rgb(100, 149, 237);
}

.game-hud__item-text {
    color: white;
    font-size: 14px;
    white-space: nowrap;
}

/* --- AI Status Container (Top Center) --- */
.game-hud__ai-container {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    background-color: rgba(20, 20, 20, 0.85);
    border-radius: 20px;
    padding: 8px 16px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(100, 149, 237, 0.5);
}

.game-hud__ai-label {
    color: rgb(100, 149, 237);
    -unity-font-style: bold;
    font-size: 16px;
    margin-right: 12px;
}

.game-hud__ai-stop-button {
    background-color: rgb(200, 60, 60);
    color: white;
    border-width: 0;
    border-radius: 4px;
    font-size: 14px;
    padding: 4px 12px;
    height: 28px;
    transition-duration: 0.1s;
    height: 28px;
    transition-duration: 0.1s;
}

.game-hud__ai-stop-button:hover {
    background-color: rgb(230, 80, 80);
    scale: 1.05;
}

.game-hud__ai-stop-button:active {
    background-color: rgb(160, 40, 40);
    scale: 0.95;
}
