.interaction-prompt {
    position: absolute;
    translate: -50% -50%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 8px;
    padding: 8px 12px;
    transition-property: opacity;
    transition-duration: 0.2s;
    pointer-events: none;
}

.interaction-prompt__content {
    flex-direction: row;
    align-items: center;
}

.interaction-prompt__key {
    background-color: white;
    color: black;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.interaction-prompt__action {
    color: white;
    font-size: 16px;
}

.interaction-prompt__progress-circle {
    width: 100%;
    height: 4px;
    background-color: rgba(90, 90, 90, 0.8);
    margin-top: 8px;
    border-radius: 2px;
}

.interaction-prompt__progress-fill {
    height: 100%;
    background-color: white;
    border-radius: 2px;
    width: 0;
}
