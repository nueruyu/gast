.command-modal {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
}

.command-modal__container {
    background-color: rgb(40, 40, 40);
    border-color: rgb(80, 80, 80);
    border-width: 2px;
    border-radius: 10px;
    padding: 20px;
    width: 500px;
}

.command-modal__title {
    font-size: 20px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 15px;
}

.command-modal__input {
    font-size: 16px;
    height: 40px;
    margin-bottom: 15px;
}

.command-modal__input > #unity-text-input {
    background-color: rgb(20, 20, 20);
    color: white;
    border-color: rgb(60, 60, 60);
    border-width: 1px;
    border-radius: 4px;
}

.command-modal__button {
    height: 45px;
    font-size: 18px;
    background-color: cornflowerblue;
    color: white;
    border-width: 0;
    border-radius: 4px;
}

.command-modal__button:hover {
    background-color: royalblue;
}
