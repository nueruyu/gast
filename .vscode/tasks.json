{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MCP SuperAssistant Proxy via npx",
      "type": "shell",
      "command": "npx @srbhptl39/mcp-superassistant-proxy@latest --config ./mcp-config.json",
      "problemMatcher": []
    },
    {
      "label": "Bundle Games",
      "type": "shell",
      "command": "bundle-md",
      "args": ["Assets/__Project", "Builds/bundle-outputs/descrio-games.md"]
    },
    {
      "label": "Bundle And Copy Games",
      "type": "shell",
      "dependsOn": "Bundle Games",
      "problemMatcher": [],
      "windows": {
        "command": "Set-Clipboard -Path \"Builds/bundle-outputs/descrio-games.md\""
      },
      "osx": {
        "command": "osascript -e 'tell app \"Finder\" to set the clipboard to ( POSIX file \"Builds/bundle-outputs/descrio-games.md\" )'"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
